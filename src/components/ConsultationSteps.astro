---
const steps = [
  {
    number: '01',
    title: 'Pilih inspirasi',
    desc: 'Jelajahi model dan finishing yang sesuai dengan konsep ruangmu.',
    icon: (
      `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>`
    )
  },
  {
    number: '02',
    title: 'Konsultasi',
    desc: 'Kirim kode model dan tanyakan spesifikasi, finishing, serta ketersediaannya.',
    icon: (
      `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>`
    )
  },
  {
    number: '03',
    title: 'Konfirmasi detail',
    desc: 'Pastikan detail produk, ukuran, harga, garansi, dan layanan sebelum memesan.',
    icon: (
      `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>`
    )
  }
];
---

<section class="py-16 sm:py-20 bg-momo-cream border-t border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-4 h-0.5 bg-momo-red"></div>
          <span class="text-[11px] font-bold uppercase tracking-widest text-momo-red">
            YOUR NEXT STEP
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 leading-tight">
          Mulai dari<br />
          <span class="font-editorial-italic font-normal">percakapan sederhana.</span>
        </h2>
      </div>
      <p class="max-w-sm text-xs sm:text-sm text-zinc-500 leading-relaxed">
        Belum yakin model mana yang tepat? Buka katalog, pilih referensi, lalu hubungi tim MOMO untuk mengecek detail.
      </p>
    </div>

    <!-- 3 Steps Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {steps.map((step) => (
        <div class="bg-white rounded-xl p-6 border border-zinc-200 shadow-xs relative group hover:border-momo-red transition">
          <span class="absolute top-6 right-6 text-xs font-bold text-zinc-300 group-hover:text-momo-red transition-colors">
            {step.number}
          </span>
          <div class="w-12 h-12 rounded-xl bg-red-50 text-momo-red flex items-center justify-center mb-5" set:html={step.icon} />
          <h3 class="text-base font-bold text-zinc-900 mb-2">{step.title}</h3>
          <p class="text-xs text-zinc-500 leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
