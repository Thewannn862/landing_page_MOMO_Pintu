---
---
<section class="bg-white border-b border-momo-border py-7 relative z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8 divide-x-0 md:divide-x divide-zinc-200">
      <!-- Metric 1 -->
      <div class="flex items-center gap-3.5 pr-2">
        <div class="text-3xl lg:text-4xl font-extrabold text-momo-red tracking-tight flex items-baseline">
          4,5<span class="text-base font-semibold text-zinc-500 ml-1">cm</span>
        </div>
        <div class="text-xs leading-snug">
          <span class="font-bold text-zinc-900 block">Inti kayu tebal</span>
          <span class="text-zinc-500">Meredam suara bising</span>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="flex items-center gap-3.5 md:pl-6 pr-2">
        <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-momo-red shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="text-xs leading-snug">
          <span class="font-bold text-zinc-900 block">Material HMR</span>
          <span class="text-zinc-500">Kepadatan padat anti lembap</span>
        </div>
      </div>

      <!-- Metric 3 -->
      <div class="flex items-center gap-3.5 md:pl-6 pr-2">
        <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-momo-red shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="text-xs leading-snug">
          <span class="font-bold text-zinc-900 block">Finishing melamin</span>
          <span class="text-zinc-500">Rapih tahan goresan</span>
        </div>
      </div>

      <!-- Metric 4 -->
      <div class="flex items-center gap-3.5 md:pl-6">
        <div class="text-3xl lg:text-4xl font-extrabold text-momo-red tracking-tight flex items-baseline">
          3<span class="text-xs font-semibold text-zinc-500 ml-1">Tahun</span>
        </div>
        <div class="text-xs leading-snug">
          <span class="font-bold text-zinc-900 block">Garansi tercantum</span>
          <span class="text-zinc-500">Struktur ketahanan dari MOMO</span>
        </div>
      </div>
    </div>
  </div>
</section>
