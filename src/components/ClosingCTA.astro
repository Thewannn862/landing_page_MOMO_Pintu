---
import { getWhatsAppUrl } from '../utils/whatsapp';

const whatsappUrl = getWhatsAppUrl('Halo MOMO Pintu Kayu, saya sudah melihat katalog pintu dan ingin menanyakan detail serta pemesanan.');
---

<section class="bg-white pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-momo-dark rounded-2xl p-8 sm:p-12 text-white relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-8 shadow-xl">
      <!-- Giant Watermark M in banner -->
      <div class="absolute right-6 top-1/2 -translate-y-1/2 text-[260px] font-black text-white/[0.04] select-none pointer-events-none watermark-m">
        M
      </div>

      <div class="relative z-10 space-y-2 max-w-xl">
        <span class="text-[10px] font-bold tracking-widest uppercase text-zinc-400 block">
          LET&apos;S TALK ABOUT YOUR SPACE
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">
          Sudah menemukan<br />
          <span class="font-editorial-italic font-normal">pintu yang kamu suka?</span>
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400">
          Kirim kode model pilihanmu. Tim MOMO siap membantu mengecek semua detailnya.
        </p>
      </div>

      <div class="relative z-10 shrink-0">
        <a
          class="inline-flex items-center gap-3 bg-momo-yellow hover:bg-momo-yellowHover text-zinc-900 font-bold px-7 py-3.5 rounded-full text-xs uppercase tracking-wider transition-all shadow-lg focus:outline-none focus:ring-2 focus:ring-white"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Hubungi MOMO via WhatsApp</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
