---
import Layout from '../layouts/Layout.astro';
import TopAnnouncement from '../components/TopAnnouncement.astro';
import Navbar from '../components/Navbar';
import HeroSection from '../components/HeroSection.astro';
import FactStrip from '../components/FactStrip.astro';
import ProductCatalog from '../components/ProductCatalog';
import FinishingPalette from '../components/FinishingPalette.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import MaterialDetails from '../components/MaterialDetails.astro';
import ConsultationSteps from '../components/ConsultationSteps.astro';
import FAQAccordion from '../components/FAQAccordion';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout
  title="MOMO Pintu Kayu - Desain yang Terasa Seperti Rumah | PT MOMO Dekorasi Rumah Jaya"
  description="Koleksi pintu interior kayu solid presisi MOMO. Inti kayu tebal 4,5 cm, material HMR tahan lembap, ragam finishing melamin rapi, dan garansi resmi 3 tahun."
>
  <!-- Top Announcement Bar -->
  <TopAnnouncement />

  <!-- Sticky Navbar with Mobile Menu -->
  <Navbar client:load />

  <main id="main-content">
    <!-- Hero Section -->
    <HeroSection />

    <!-- 4 Key Facts Strip -->
    <FactStrip />

    <!-- Interactive Product Catalog -->
    <ProductCatalog client:load />

    <!-- 5 Finishing Swatches Palette -->
    <FinishingPalette />

    <!-- Why MOMO / Benefits Section -->
    <BenefitsSection />

    <!-- Technical Material & Detail -->
    <MaterialDetails />

    <!-- 3 Simple Consultation Steps -->
    <ConsultationSteps />

    <!-- Interactive FAQ Accordion -->
    <FAQAccordion client:visible />

    <!-- Closing Call to Action Banner -->
    <ClosingCTA />
  </main>

  <!-- Main Footer -->
  <Footer />

  <!-- Floating WhatsApp CTA -->
  <FloatingWhatsApp />
</Layout>
