---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MOMO Pintu Kayu - Desain yang Terasa Seperti Rumah | PT MOMO Dekorasi Rumah Jaya',
  description = 'Produsen pintu interior kayu solid presisi dengan standar modern. Inti kayu tebal 4,5 cm, material HMR tahan lembap, finishing melamin rapi, dan garansi 3 tahun.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/momo/hero/interior-door-hero.jpg" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts: Inter & Newsreader -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500;1,6..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-zinc-800 antialiased font-sans selection:bg-momo-red selection:text-white">
    <slot />
  </body>
</html>
